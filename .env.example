# Copy to .env and fill in. Never commit .env. Never paste these values into a chat or prompt.

# --- Webull Singapore OpenAPI ---
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=sg
# uat = Webull test environment; prod = your real account
WEBULL_ENVIRONMENT=uat
# Where the SDK stores its 2FA token
WEBULL_TOKEN_DIR=./conf

# --- LLM Models (Tiered: Fast Screener + Deep Strategist) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-3-7-sonnet-latest
LLM_MODEL_FAST=claude-3-5-haiku-latest

# --- Runtime ---
# shadow: record intended orders, send nothing to the broker
# broker: send orders to WEBULL_ENVIRONMENT. Against prod this ALSO requires
#         live_trading.enabled: true in config/risk_limits.yaml.
TRADING_MODE=shadow
STATE_DIR=./state
