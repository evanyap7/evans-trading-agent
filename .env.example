# Copy to .env and fill in. Never commit .env. Never paste these values into a chat or prompt.

# --- Webull Singapore OpenAPI ---
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=sg
# uat = Webull test environment; prod = your real account
WEBULL_ENVIRONMENT=uat
# Where the SDK stores its 2FA token
WEBULL_TOKEN_DIR=./conf

# --- LLM Models (Tiered: Fast Screener + Deep Strategist) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-4-5

# --- Telegram Alerts (Falls back to ~/telegram-personal-assistant/.env.local if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Runtime ---
# shadow: record intended orders, send nothing to the broker
# broker: send orders to WEBULL_ENVIRONMENT. Against prod this ALSO requires
#         live_trading.enabled: true in config/risk_limits.yaml.
TRADING_MODE=shadow
STATE_DIR=./state
CONTINUOUS_TRADING=false
SCAN_INTERVAL_MINUTES=10   # intraday scan cadence when CONTINUOUS_TRADING is on (5-60)

# --- Databento Institutional Market Data ---
# Get API key from https://databento.com/portal/keys
DATABENTO_API_KEY=
# Default historical dataset: EQUS.SUMMARY (daily OHLCV), XNAS.ITCH, GLBX.MDP3, etc.
DATABENTO_DATASET=EQUS.SUMMARY
# Safety budget cap in USD per query to prevent runaway spend (default: $1.00 USD)
DATABENTO_COST_LIMIT_USD=1.00
# Market data source for backtesting: yfinance or databento
DATA_SOURCE=yfinance

