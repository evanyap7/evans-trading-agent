<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd job: runs `trading-agent morning-report` every morning at 9:00 AM SGT (UTC+8).
     Install:  cp scripts/com.trading-agent.morning-briefing.plist ~/Library/LaunchAgents/
               launchctl load ~/Library/LaunchAgents/com.trading-agent.morning-briefing.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.trading-agent.morning-briefing</string>
  <key>WorkingDirectory</key><string>/Users/evanyap7/trading-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>trading-agent</string>
    <string>morning-report</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/evanyap7/trading-agent/state/morning_briefing.log</string>
  <key>StandardErrorPath</key><string>/Users/evanyap7/trading-agent/state/morning_briefing.err</string>
</dict>
</plist>
